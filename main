from recommender import FriendRecommender

def main():
    recommender = FriendRecommender()
    print("Loaded graph with", recommender.graph.number_of_nodes(), "nodes and", recommender.graph.number_of_edges(), "edges.")
    try:
        user_id = int(input("Enter User ID (1–100): ").strip())
    except:
        print("Invalid input, defaulting to 1")
        user_id = 1

    print("\nChoose Recommendation Method:")
    print("1. Common Neighbors\n2. Jaccard Coefficient\n3. Adamic-Adar\n4. Most Popular")
    choice = input("Enter choice (1/2/3/4): ").strip()
    mapping = { "1": "common", "2": "jaccard", "3": "adamic", "4": "popular" }
    method = mapping.get(choice, "common")
    recommender.display_recommendations(user_id, method=method, top_k=10)

if __name__ == '__main__':
    main()
